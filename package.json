{
  "name": "@swimmwatch/dsh-tool-search",
  "icon": "assets/logo.png",
  "version": "1.0.0",
  "description": "Native tool search for DeepSeek Harness: discover built-in, plugin and MCP tools with BM25 or optional semantic embeddings.",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "assets/logo.png",
    "dist/src/client/settings.css",
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "PROVENANCE.json",
    "dist/client.js"
  ],
  "engines": {
    "node": ">=24 <25",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/build-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx scripts/build-ui-test-runtime.ts && tsx --import ./scripts/register-ui-sdk.ts --test test/*.test.ts test/core/*.test.ts",
    "test:coverage": "tsx scripts/build-ui-test-runtime.ts && tsx --import ./scripts/register-ui-sdk.ts --test --experimental-test-coverage test/*.test.ts test/core/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "prepare": "npm run build",
    "package:verify": "npm run build && tsx scripts/build-ui-test-runtime.ts && tsx --import ./scripts/register-ui-sdk.ts scripts/verify-package.ts",
    "benchmark": "tsx benchmarks/run.ts",
    "benchmark:live": "tsx benchmarks/run.ts --live",
    "benchmark:quality:offline": "tsx benchmarks/retrieval/quality-benchmark.ts --mode=hybrid --embedding=deterministic --gate=stability",
    "benchmark:quality": "tsx benchmarks/retrieval/quality-benchmark.ts --mode=hybrid --embedding=ollama",
    "benchmark:metamorphic": "tsx benchmarks/retrieval/metamorphic-benchmark.ts",
    "benchmark:scale": "tsx benchmarks/performance/scale-benchmark.ts",
    "benchmark:native": "tsx benchmarks/native/native-benchmark.ts",
    "policy:check": "tsx scripts/check-policy.ts",
    "package:smoke": "tsx scripts/smoke-package.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:publish": "tsx scripts/publish-release.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@eslint/js": "^10.0.1",
    "@shikijs/langs": "4.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "immer": "10.1.1",
    "jiti": "^2.6.1",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "prettier": "^3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "zustand": "4.5.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "semver": "7.8.4",
    "@types/semver": "7.7.1"
  },
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swimmwatch/dsh-tool-search.git"
  },
  "bugs": {
    "url": "https://github.com/swimmwatch/dsh-tool-search/issues"
  },
  "homepage": "https://github.com/swimmwatch/dsh-tool-search#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tool-search",
    "mcp",
    "ai-agents",
    "context-management",
    "semantic-search",
    "bm25",
    "ollama",
    "openai",
    "typescript"
  ],
  "overrides": {
    "zod": "$zod"
  }
}
